# Copy to .env and fill in. .env is gitignored; this file is documentation.

# Required for the Options Scanner page only. The Intraday Stocks page runs on free
# Yahoo data and needs no key — without a Polygon key it simply falls back to
# conservative liquidity tiers instead of live quoted spreads when estimating cost.
# Polygon is now Massive (massive.com); the same key works on api.polygon.io.
# The Options Starter plan is enough: chain snapshots with greeks/IV/OI and
# 15-minute option bars, 15-minute delayed. It has no bid/ask quotes, so tick
# "Allow missing bid-ask spread" in the sidebar, or every contract is rejected.
POLYGON_API_KEY=

# Where the SQLite database lives. The default is deliberately outside the project
# directory: OneDrive and SQLite WAL files produce lock and sync conflicts that show up
# as "database is locked" mid-scan.
OPTIONS_DB_PATH=%LOCALAPPDATA%\StockOptionsCodex\options_screening.sqlite3

# Push alerts for new signals and their outcomes (SUCCESS / FAILED / EXPIRED). Any of:
#   https://ntfy.sh/<your-private-topic>   free iPhone push: install the ntfy app and
#                                          subscribe to the same long, unguessable topic
#   https://discord.com/api/webhooks/...   Discord channel webhook
#   https://hooks.slack.com/services/...   Slack incoming webhook
#   any other URL                          receives a JSON POST
# Blank = alerts are logged to the Alerts tab only. The dashboard sidebar can also set it.
OPTIONS_ALERT_WEBHOOK_URL=
