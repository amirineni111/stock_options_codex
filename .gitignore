# ── Secrets & credentials ──────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Virtual environment ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Database & data files ───────────────────────────────────────────────────
data/
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db

# ── Python cache ────────────────────────────────────────────────────────────
# The trailing-suffix patterns matter here: OneDrive leaves behind files named
# `app.cpython-39.pyc.1851713261040` when it syncs a directory mid-write, and a bare
# `*.pyc` does not match those. Several hundred had accumulated untracked.
__pycache__/
*.py[cod]
*.pyc.*
*.pyo
*.pyd
.Python

# ── Build / distribution ─────────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/

# ── Testing & coverage ──────────────────────────────────────────────────────
.pytest_cache/
pytest-cache-files-*/
.coverage
htmlcov/
.tox/

# ── IDE & editor ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
*~

# ── OS artifacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Streamlit ───────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── App preferences (local UI state) ────────────────────────────────────────
data/app_preferences.json

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Personal scratch notes ──────────────────────────────────────────────────
# Contained machine-specific paths and freeform trading notes. The parts worth
# keeping are in the README.
stock_options_streamlit-command.txt
